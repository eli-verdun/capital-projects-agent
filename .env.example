# Populate locally; never commit real credentials.
LANGSMITH_API_KEY=
LANGSMITH_GATEWAY_API_KEY=
LANGSMITH_WORKSPACE_ID=
LANGSMITH_TRACING=true
# Region. Leave unset for US. APAC: https://apac.api.smith.langchain.com, EU: https://eu.api.smith.langchain.com
# The UI and LLM Gateway hosts follow this region (see src/project_advisor/endpoints.py).
# A LANGSMITH_ENDPOINT exported in your shell wins over this file, so unset it there.
# LANGSMITH_ENDPOINT=

# Agent addressing (agent-based workspaces). Traces go to this agent and environment.
# Register the agent once with: uv run python -m scripts.setup_agent
# Environment is one of: local, development, staging, production.
# Do NOT set LANGSMITH_PROJECT here: with both set, the SDK traces nothing.
LANGSMITH_AGENT_ID=capital-projects-agent
LANGSMITH_AGENT_ENVIRONMENT=production

AGENT_MODEL=gpt-5.4
GUARDRAIL_MODEL=gpt-5.4-nano
EVAL_JUDGE_MODEL=gpt-5.4-mini
CONTEXT_HUB_VERSION=production
